{
  "name": "portfolio-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/throttler": "6.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
