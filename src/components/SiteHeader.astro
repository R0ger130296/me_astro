---
import { Compass, Mail, Menu, MoonStar, Sun, X } from '@lucide/astro';

type Props = { contactHref: string; sectionPrefix?: string; showTour?: boolean };
const { contactHref, sectionPrefix = '', showTour = true } = Astro.props;
---
<header class="site-header" data-header>
  <nav class="shell nav" aria-label="Navegación principal">
    <a class="brand" href={`${sectionPrefix}#inicio`} aria-label="Ir al inicio">
      <span class="brand-mark">RC</span>
      <span><strong>Roger Cedeño</strong><small>Full Stack · Product Builder</small></span>
    </a>
    <div class="nav-links" data-nav-links>
      <a href={`${sectionPrefix}#proyectos`}>Trabajo</a><a href={`${sectionPrefix}#trayectoria`}>Trayectoria</a><a href={`${sectionPrefix}#formacion`}>Formación</a><a href={`${sectionPrefix}#servicios`}>Capacidades</a><a href={`${sectionPrefix}#sobre-mi`}>Perfil</a><a href={`${sectionPrefix}#contacto`}>Contacto</a>
    </div>
    <div class="nav-actions">
      {showTour && <button class="tour-nav" type="button" data-tour-launch aria-label="Iniciar recorrido guiado"><Compass size={17} /><span>Recorrido</span></button>}
      <button class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema" data-theme-toggle>
        <Sun class="theme-icon theme-icon-sun" size={19} aria-hidden="true" />
        <MoonStar class="theme-icon theme-icon-moon" size={19} aria-hidden="true" />
      </button>
      <a class="nav-cv" href="/Roger-Cedeno-CV.pdf" download><span>CV</span></a>
      <a class="nav-cta" href={contactHref}><Mail size={16} />Hablemos</a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button><Menu size={21} /><X size={21} /></button>
    </div>
  </nav>
</header>
