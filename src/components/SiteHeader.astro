---
import { Compass, Mail, Menu, MoonStar, Sun, X } from '@lucide/astro';

type Props = { contactHref: string };
const { contactHref } = Astro.props;
---
<header class="site-header" data-header>
  <nav class="shell nav" aria-label="Navegación principal">
    <a class="brand" href="#inicio" aria-label="Ir al inicio">
      <span class="brand-mark">RC</span>
      <span><strong>Roger Cedeño</strong><small>Full Stack · Product Builder</small></span>
    </a>
    <div class="nav-links" data-nav-links>
      <a href="#proyectos">Trabajo</a><a href="#trayectoria">Trayectoria</a><a href="#formacion">Formación</a><a href="#servicios">Capacidades</a><a href="#sobre-mi">Perfil</a><a href="#contacto">Contacto</a>
    </div>
    <div class="nav-actions">
      <button class="tour-nav" type="button" data-tour-launch aria-label="Iniciar recorrido guiado"><Compass size={17} /><span>Recorrido</span></button>
      <button class="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema" data-theme-toggle>
        <Sun class="theme-icon theme-icon-sun" size={19} aria-hidden="true" />
        <MoonStar class="theme-icon theme-icon-moon" size={19} aria-hidden="true" />
      </button>
      <a class="nav-cta" href={contactHref}><Mail size={16} />Hablemos</a>
      <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-button><Menu size={21} /><X size={21} /></button>
    </div>
  </nav>
</header>
