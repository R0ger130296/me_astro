---
import { ArrowUpRight, Check, MoonStar } from '@lucide/astro';
import { principles, profile, technologies } from '../data/portfolio';
---
<section id="sobre-mi" class="section shell about-layout"><div class="about-intro reveal"><span class="kicker">Cómo trabajo</span><h2>Ingeniería con criterio de producto.</h2><p>No separo “lo técnico” de “la experiencia”. Una buena solución debe ser usable, mantenible, rápida y útil para el negocio.</p><a class="text-link" href={profile.github} target="_blank" rel="noreferrer">Ver actividad en GitHub <ArrowUpRight size={16} /></a></div><div class="principles reveal">{principles.map((principle) => <div><span><Check size={17} /></span><p>{principle}</p></div>)}</div><aside class="profile-card reveal"><div class="profile-card-top"><MoonStar size={22} /><span>Perfil profesional</span></div><h3>Full Stack con visión transversal</h3><p>Experiencia en frontend, backend, mobile, bases de datos, cloud y automatización de entrega.</p><div class="mini-stack">{technologies.map((technology) => <span>{technology}</span>)}</div></aside></section>
