---
import { profile } from '../data/portfolio';
interface Props { year: number; sectionPrefix?: string; }
const { year, sectionPrefix = '' } = Astro.props;
---
<footer class="footer shell"><div class="brand"><span class="brand-mark">RC</span><span><strong>{profile.name}</strong><small>{profile.role}</small></span></div><p>© {year} · Diseñado y construido con intención.</p><nav><a href={`${sectionPrefix}#inicio`}>Inicio</a><a href={`${sectionPrefix}#proyectos`}>Trabajo</a><a href={`${sectionPrefix}#trayectoria`}>Trayectoria</a><a href={`${sectionPrefix}#formacion`}>Formación</a><a href={`${sectionPrefix}#contacto`}>Contacto</a></nav></footer>
