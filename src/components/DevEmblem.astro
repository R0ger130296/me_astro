---
const emblem = 'data:image/webp;base64,';
---
<button class="dev-emblem" type="button" data-dev-emblem aria-label="Cambiar firma técnica">
  <img src={emblem} alt="Emblema personal de Roger Cedeño como desarrollador" width="128" height="128" />
  <span class="dev-emblem-copy"><small>Developer signature</small><strong data-dev-emblem-line>build → test → deploy</strong></span>
</button>

<script>
  const emblemButton = document.querySelector<HTMLElement>('[data-dev-emblem]');
  const emblemLine = document.querySelector<HTMLElement>('[data-dev-emblem-line]');
  const lines = ['build → test → deploy', 'UI → API → Data', '</> me_astro', 'understand → architect → ship'];
  let lineIndex = 0;
  emblemButton?.addEventListener('click', () => {
    lineIndex = (lineIndex + 1) % lines.length;
    if (emblemLine) emblemLine.textContent = lines[lineIndex] ?? lines[0];
  });
</script>
