---
import { careerStats } from '../data/career';
import { certificateStats } from '../data/certificates';

type Props = { languagesCount: number };
const { languagesCount } = Astro.props;
---
<section class="signal-strip shell" aria-label="Indicadores profesionales">
  <article><strong>{careerStats.companies}</strong><span>Organizaciones</span></article>
  <article><strong>{careerStats.roles}</strong><span>Etapas profesionales</span></article>
  <article><strong>{languagesCount || 10}+</strong><span>Tecnologías activas</span></article>
  <article><strong>{certificateStats.hours}h</strong><span>Formación certificada</span></article>
</section>
