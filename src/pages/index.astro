---
import '../styles/global.css';
import '../styles/certificates.css';
import '../styles/career.css';
import '../styles/developer-showcase.css';
import AboutSection from '../components/AboutSection.astro';
import CapabilitiesSection from '../components/CapabilitiesSection.astro';
import CareerSection from '../components/CareerSection.astro';
import CertificatesSection from '../components/CertificatesSection.astro';
import ContactSection from '../components/ContactSection.astro';
import DeveloperShowcase from '../components/DeveloperShowcase.astro';
import Hero from '../components/Hero.astro';
import GuidedTour from '../components/GuidedTour.astro';
import ProcessSection from '../components/ProcessSection.astro';
import SignalStrip from '../components/SignalStrip.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInit from '../components/ThemeInit.astro';
import WorkSections from '../components/WorkSections.astro';
import { careerRoles, education } from '../data/career';
import { certificates } from '../data/certificates';
import { profile, technologies } from '../data/portfolio';
import { getGitHubRepos } from '../services/github';

const repositories = await getGitHubRepos();
const languagesCount = technologies.length;
const year = new Date().getFullYear();
const canonical = new URL('/', Astro.site ?? 'https://me-astro-alpha.vercel.app').toString();
const title = 'Roger Cedeño | Full Stack Developer & Product Builder';
const description = 'Portafolio de Roger Cedeño, desarrollador Full Stack especializado en productos web, móviles, cloud y experiencias digitales centradas en negocio.';
const contactHref = `mailto:${profile.email}?subject=${encodeURIComponent('Hablemos sobre un proyecto')}&body=${encodeURIComponent('Hola Roger,\n\nQuiero conversar contigo sobre:\n\nContexto del proyecto:\nResultado que buscamos:\nPlazo aproximado:\n\nSaludos.')}`;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Person', name: profile.name, jobTitle: profile.role,
  url: canonical, image: `${canonical}me/1757515565808.jpeg`, email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'EC' }, sameAs: [profile.github], knowsAbout: technologies,
  alumniOf: education.map((item) => ({ '@type': 'EducationalOrganization', name: item.institution })),
  worksFor: careerRoles.filter((role) => role.current).map((role) => ({ '@type': 'Organization', name: role.company })),
  hasCredential: certificates.map((certificate) => ({ '@type': 'EducationalOccupationalCredential', name: certificate.title, credentialCategory: certificate.category, recognizedBy: { '@type': 'Organization', name: certificate.issuer }, url: certificate.credentialUrl })),
};
---
<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ThemeInit />
    <meta name="description" content={description} /><meta name="author" content={profile.name} />
    <meta name="theme-color" content="#08040d" /><meta name="color-scheme" content="light dark" /><meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" /><link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="es_EC" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={`${canonical}og-image.png`} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Roger Cedeño, Full Stack Developer y Product Builder" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={`${canonical}og-image.png`} /><meta name="twitter:image:alt" content="Roger Cedeño, Full Stack Developer y Product Builder" />
    <title>{title}</title><script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a><div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
    <SiteHeader contactHref={contactHref} />
    <main id="contenido"><Hero contactHref={contactHref} /><SignalStrip languagesCount={languagesCount} /><WorkSections repositories={repositories} /><DeveloperShowcase /><CareerSection /><CertificatesSection /><CapabilitiesSection /><AboutSection /><ProcessSection /><ContactSection /></main>
    <SiteFooter year={year} />
    <GuidedTour />
    <script>import '../scripts/site'; import '../scripts/enhancements';</script>
  </body>
</html>
